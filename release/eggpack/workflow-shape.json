  ],
  "selected_aliases": [
    "linux-x64",
    "linux-arm64",
    "macos-x64",
    "macos-arm64",
    "windows-x64"
  ],
  "build_bindings": {
    "schema_version": 1,
    "targets": {
      "aarch64-apple-darwin": [
        { "selector": { "kind": "direct" }, "package": "eggsact", "binary": "eggsact" }
      ],
      "aarch64-unknown-linux-gnu": [
        { "selector": { "kind": "direct" }, "package": "eggsact", "binary": "eggsact" }
      ],
      "x86_64-apple-darwin": [
        { "selector": { "kind": "direct" }, "package": "eggsact", "binary": "eggsact" }
